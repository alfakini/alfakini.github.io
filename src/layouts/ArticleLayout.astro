---
import type { ImageMetadata } from 'astro';
import { SITE_TITLE } from '../consts';
import { currentLocale, useT } from '../i18n';
import { routeUrl } from '../i18n/routes';
import { tagSlug } from '../lib/essays';
import HeroImage from '../components/HeroImage.astro';
import BaseLayout from './BaseLayout.astro';

interface Article {
	title: string;
	description: string;
	tags: string[];
	hero_image?: ImageMetadata;
	published_at?: Date;
	updated_at?: Date;
}

interface Props {
	article: Article;
	image?: ImageMetadata;
	linkTags?: boolean;
}
const { article, image = article.hero_image, linkTags = false }: Props = Astro.props;
const lang = currentLocale(Astro.currentLocale);
const t = useT(lang);
const hasTags = article.tags.length > 0;
const hasFooter = Astro.slots.has('footer');
const pageTitle = `${article.title} | ${SITE_TITLE}`;
---

<BaseLayout title={pageTitle} description={article.description} {image} type="article" published_at={article.published_at} updated_at={article.updated_at} tags={article.tags}>
	<article class="essay-article">
		<header class="essay-header">
			<slot name="meta" />
			<h1>{article.title}</h1>
		</header>
		{article.hero_image && <HeroImage src={article.hero_image} />}
		<section class="prose">
			<slot />
		</section>
		<footer class="essay-footer sans" data-has-tags={hasTags} data-has-footer={hasFooter} data-note-label={t('article.seeNote')} hidden={!hasTags && !hasFooter}>
			<div class="essay-footnotes" hidden>
				<h2>{t('article.notes')}</h2>
				<ol></ol>
			</div>
			{hasTags && <ul class="tag-list" aria-label={t('article.tags')}>
				{article.tags.map((tag) => <li>{linkTags ? <a href={routeUrl(lang, 'tags', tagSlug(tag))}>#{tag}</a> : <>#{tag}</>}</li>)}
			</ul>}
			<slot name="footer" />
		</footer>
	</article>
</BaseLayout>

<script>
	const article = document.querySelector('.essay-article');
	const footer = article?.querySelector('.essay-footer');
	const footnotes = footer?.querySelector('.essay-footnotes');
	const list = footnotes?.querySelector('ol');
	// Below this width, sidenotes no longer fit beside the fixed reading column.
	const narrowLayout = window.matchMedia('(max-width: 1440px)');

	if (article && footer instanceof HTMLElement && footnotes instanceof HTMLElement && list) {
		const notes = [...article.querySelectorAll('.prose label.sidenote-number')].flatMap((label, index) => {
			const input = label.nextElementSibling;
			const note = input?.nextElementSibling;
			if (!(label instanceof HTMLLabelElement) || !(input instanceof HTMLInputElement) || !(note instanceof HTMLElement) || !note.classList.contains('sidenote')) return [];

			const reference = document.createElement('a');
			reference.className = 'footnote-reference';
			reference.href = `#${note.id}`;
			reference.id = label.id;
			reference.textContent = String(index + 1);
			reference.setAttribute('aria-label', `${footer.dataset.noteLabel} ${index + 1}`);

			const item = document.createElement('li');
			return [{ label, input, note, reference, item }];
		});

		const updateFootnotes = () => {
			if (narrowLayout.matches && notes.length > 0) {
				for (const { label, note, reference, item } of notes) {
					label.replaceWith(reference);
					item.append(note);
					list.append(item);
				}
				footnotes.hidden = false;
				footer.hidden = false;
				return;
			}

			for (const { label, input, note, reference, item } of notes) {
				reference.replaceWith(label);
				input.after(note);
				item.remove();
			}
			footnotes.hidden = true;
			footer.hidden = footer.dataset.hasTags !== 'true' && footer.dataset.hasFooter !== 'true';
		};

		updateFootnotes();
		narrowLayout.addEventListener('change', updateFootnotes);
	}
</script>
