---
import { SITE_TITLE } from '../consts';
import { currentLocale, useT } from '../i18n';
import { routeUrl } from '../i18n/routes';
import type { Essay } from '../lib/essays';
import { tagSlug } from '../lib/essays';
import EssayMeta from '../components/EssayMeta.astro';
import HeroImage from '../components/HeroImage.astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
	essay: Essay;
}
const { essay } = Astro.props;
const lang = currentLocale(Astro.currentLocale);
const t = useT(lang);
const hasTags = essay.data.tags.length > 0;
const pageTitle = `${essay.data.title} | ${SITE_TITLE}`;
---

<BaseLayout title={pageTitle} description={essay.data.description} image={essay.data.hero_image} type="article" published_at={essay.data.published_at} updated_at={essay.data.updated_at} tags={essay.data.tags}>
	<article class="essay-article">
		<header class="essay-header">
			<EssayMeta {essay} updatedLabel={t('article.updated')} />
			<h1>{essay.data.title}</h1>
		</header>
		{essay.data.hero_image && <HeroImage src={essay.data.hero_image} />}
		<section class="prose">
			<slot />
		</section>
		<footer class="essay-footer sans" data-has-tags={hasTags} data-note-label={t('article.seeNote')} hidden={!hasTags}>
			<div class="essay-footnotes" hidden>
				<h2>{t('article.notes')}</h2>
				<ol></ol>
			</div>
			{hasTags && <ul class="tag-list" aria-label={t('article.tags')}>
				{essay.data.tags.map((tag) => <li><a href={routeUrl(lang, 'tags', tagSlug(tag))}>#{tag}</a></li>)}
			</ul>}
		</footer>
	</article>
</BaseLayout>

<script>
	const article = document.querySelector('.essay-article');
	const footer = article?.querySelector('.essay-footer');
	const footnotes = footer?.querySelector('.essay-footnotes');
	const list = footnotes?.querySelector('ol');
	const narrowLayout = window.matchMedia('(max-width: 760px)');

	if (article && footer instanceof HTMLElement && footnotes instanceof HTMLElement && list) {
		const notes = [...article.querySelectorAll('.prose label.sidenote-number')].flatMap((label, index) => {
			const input = label.nextElementSibling;
			const note = input?.nextElementSibling;
			if (!(label instanceof HTMLLabelElement) || !(input instanceof HTMLInputElement) || !(note instanceof HTMLElement) || !note.classList.contains('sidenote')) return [];

			const reference = document.createElement('a');
			reference.className = 'footnote-reference';
			reference.href = `#${note.id}`;
			reference.id = label.id;
			reference.textContent = String(index + 1);
			reference.setAttribute('aria-label', `${footer.dataset.noteLabel} ${index + 1}`);

			const item = document.createElement('li');
			return [{ label, input, note, reference, item }];
		});

		const updateFootnotes = () => {
			if (narrowLayout.matches && notes.length > 0) {
				for (const { label, note, reference, item } of notes) {
					label.replaceWith(reference);
					item.append(note);
					list.append(item);
				}
				footnotes.hidden = false;
				footer.hidden = false;
				return;
			}

			for (const { label, input, note, reference, item } of notes) {
				reference.replaceWith(label);
				input.after(note);
				item.remove();
			}
			footnotes.hidden = true;
			footer.hidden = footer.dataset.hasTags !== 'true';
		};

		updateFootnotes();
		narrowLayout.addEventListener('change', updateFootnotes);
	}
</script>
