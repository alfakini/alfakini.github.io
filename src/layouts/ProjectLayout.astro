---
import type { Project } from '../lib/projects';
import ProjectMeta from '../components/ProjectMeta.astro';
import ArticleLayout from './ArticleLayout.astro';

interface Props {
	project: Project;
}
const { project }: Props = Astro.props;
const [image] = project.data.gallery;
const { links } = project.data;
---

<ArticleLayout article={project.data} {image}>
	<ProjectMeta slot="meta" {project} />
	<slot />
	{
		links.length > 0 && (
			<ul slot="footer" class="tag-list">
				{links.map((link) => (
					<li><a href={link.href}>{link.label}</a></li>
				))}
			</ul>
		)
	}
</ArticleLayout>
