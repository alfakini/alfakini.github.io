---
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { currentLocale, locales } from '../i18n';
import { switchLocaleUrl } from '../i18n/routes';
import '../styles/site.css';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	type?: 'website' | 'article';
	published_at?: Date;
	updated_at?: Date;
	tags?: string[];
}
const { ...head } = Astro.props;
const lang = currentLocale(Astro.currentLocale);
const alternates = locales.map((locale) => ({ lang: locale, href: switchLocaleUrl(locale, Astro.url.pathname) }));
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead {...head} {lang} {alternates} />
	</head>
	<body>
		<SiteHeader />
		<main id="conteudo">
			<slot />
		</main>
		<SiteFooter />
	</body>
</html>
