---
import { Image } from 'astro:assets';

interface Props {
	images: ImageMetadata[];
}

const [lead, ...images]: ImageMetadata[] = Astro.props.images;
const thumbs = images.slice(0, 3);
---

{
	lead && (
		<figure class="entry-gallery">
			<Image class="entry-image" src={lead} widths={[352, 704]} sizes="352px" alt="" />
			{thumbs.length > 0 && (
				<div class="entry-thumbs">
					{thumbs.map((thumb) => (
						<Image class="entry-thumb" src={thumb} widths={[118, 236]} sizes="118px" alt="" />
					))}
				</div>
			)}
		</figure>
	)
}
