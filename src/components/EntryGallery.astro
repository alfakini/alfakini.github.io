---
import { Image } from 'astro:assets';

interface Props {
	images: ImageMetadata[];
}

const [lead, ...thumbs]: ImageMetadata[] = Astro.props.images;
---

{
	lead && (
		<figure class="entry-gallery">
			<Image class="entry-image" src={lead} widths={[200, 400]} sizes="200px" alt="" />
			{thumbs.length > 0 && (
				<div class="entry-thumbs">
					{thumbs.map((thumb) => (
						<Image class="entry-thumb" src={thumb} widths={[64, 128]} sizes="64px" alt="" />
					))}
				</div>
			)}
		</figure>
	)
}
