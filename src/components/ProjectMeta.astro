---
import { currentLocale, useT } from '../i18n';
import { projectYear, type Project } from '../lib/projects';

interface Props {
	project: Project;
}

const { project }: Props = Astro.props;
const lang = currentLocale(Astro.currentLocale);
const t = useT(lang);
const { start_at, end_at } = project.data;
---

<p class="essay-meta sans">
	<span>
		<time datetime={start_at}>{projectYear(start_at)}</time>
		{
			!(end_at !== null && projectYear(end_at) === projectYear(start_at)) && (
				<Fragment>
					{' '}&ndash;{' '}
					{end_at ? <time datetime={end_at}>{projectYear(end_at)}</time> : t('projects.now')}
				</Fragment>
			)
		}
	</span>
</p>
