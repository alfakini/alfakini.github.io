---
import { currentLocale } from '../i18n';
import { projectPath, type Project } from '../lib/projects';
import EntryGallery from './EntryGallery.astro';
import EntryLinks from './EntryLinks.astro';
import ProjectMeta from './ProjectMeta.astro';

interface Props {
	project: Project;
}

const { project }: Props = Astro.props;
const lang = currentLocale(Astro.currentLocale);
const { gallery, links } = project.data;
---

<article class="project-entry" data-category={project.data.category}>
	<div class="project-entry-content">
		<ProjectMeta {project} />
		<h3 class="entry-title"><a href={projectPath(project, lang)}>{project.data.title}</a></h3>
		<EntryGallery images={gallery} />
		<p class="entry-summary">{project.data.description}</p>
		<EntryLinks {links} />
	</div>
</article>
