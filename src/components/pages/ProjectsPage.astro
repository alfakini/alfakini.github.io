---
import { SITE_TITLE } from '../../consts';
import { currentLocale, useT } from '../../i18n';
import { getProjects, groupProjectsByYear } from '../../lib/projects';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../Badge.astro';
import ProjectCard from '../ProjectCard.astro';

const lang = currentLocale(Astro.currentLocale);
const t = useT(lang);
const years = groupProjectsByYear(await getProjects(lang));
const pageTitle = `${t('projects.title')} | ${SITE_TITLE}`;
---

<BaseLayout title={pageTitle} description={t('projects.description')}>
	<header class="page-header projects-header">
		<h1>{t('projects.title')}</h1>
		<p class="projects-subtitle">{t('projects.description')}</p>
	</header>
	<section class="projects-journey" aria-label={t('projects.title')}>
		<p class="projects-now"><span class="sans">{t('projects.now')}</span></p>
		{
			years.map(({ year, projects }) => (
				<Fragment>
					<h2 class="projects-year"><Badge class="sans">{year}</Badge></h2>
					{projects.map((project) => (
						<ProjectCard {project} />
					))}
				</Fragment>
			))
		}
	</section>
</BaseLayout>
