---
import { SITE_TITLE } from '../../consts';
import { currentLocale, useT } from '../../i18n';
import { getProjects, groupProjectsByYear } from '../../lib/projects';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../Badge.astro';
import ProjectCard from '../ProjectCard.astro';

const lang = currentLocale(Astro.currentLocale);
const t = useT(lang);
const projects = await getProjects(lang);
const years = groupProjectsByYear(projects);
const categories = [...new Set(projects.map((project) => project.data.category))];
const categoryLabels = {
	hardware: t('projects.hardware'),
	software: t('projects.software'),
	maker: t('projects.maker'),
};
const pageTitle = `${t('projects.title')} | ${SITE_TITLE}`;
---

<BaseLayout title={pageTitle} description={t('projects.description')}>
	<header class="page-header projects-header">
		<h1>{t('projects.title')}</h1>
		<p>{t('projects.description')}</p>
		<ul class="projects-legend sans" aria-label={t('projects.legend')}>
			{categories.map((category) => <li data-category={category}>{categoryLabels[category]}</li>)}
		</ul>
	</header>
	<section class="projects-journey" aria-label={t('projects.title')}>
		<p class="projects-now"><span class="sans">{t('projects.now')}</span></p>
		{
			years.map(({ year, projects }) => (
				<Fragment>
					<h2 class="projects-year"><Badge class="sans">{year}</Badge></h2>
					{projects.map((project) => (
						<ProjectCard {project} />
					))}
				</Fragment>
			))
		}
	</section>
</BaseLayout>
