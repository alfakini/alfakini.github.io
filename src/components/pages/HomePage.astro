---
import EssayList from '../EssayList.astro';
import { SITE_DESCRIPTION, SITE_DESCRIPTION_EN, SITE_TITLE } from '../../consts';
import { currentLocale } from '../../i18n';
import { getEssays } from '../../lib/essays';
import BaseLayout from '../../layouts/BaseLayout.astro';

const lang = currentLocale(Astro.currentLocale);
const essays = (await getEssays(lang)).slice(0, 5);
---

<BaseLayout title={SITE_TITLE} description={lang === 'en' ? SITE_DESCRIPTION_EN : SITE_DESCRIPTION}>
	<header class="page-header home-intro">
		<h1>Essays</h1>
	</header>
	<EssayList {essays} />
</BaseLayout>
