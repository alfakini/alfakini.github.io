---
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_AUTHOR, SITE_TITLE } from '../consts';
import { localeCode, openGraphLocale, type Locale } from '../lib/essays';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	type?: 'website' | 'article';
	lang?: Locale;
	pubDate?: Date;
	updatedDate?: Date;
	tags?: string[];
	alternates?: Array<{ lang: Locale; href: string }>;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image = FallbackImage, type = 'website', lang = 'pt', pubDate, updatedDate, tags = [], alternates = [] } = Astro.props;
const defaultAlternate = alternates.find((alternate) => alternate.lang === 'pt');
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('/rss.xml', Astro.site)} />
<link rel="canonical" href={canonicalURL} />
{alternates.map((alternate) => <link rel="alternate" hreflang={localeCode(alternate.lang)} href={new URL(alternate.href, Astro.site)} />)}
{defaultAlternate && <link rel="alternate" hreflang="x-default" href={new URL(defaultAlternate.href, Astro.site)} />}
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE_AUTHOR} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.site)} />
<meta property="og:image:width" content={image.width.toString()} />
<meta property="og:image:height" content={image.height.toString()} />
<meta property="og:locale" content={openGraphLocale(lang)} />
{alternates.filter((alternate) => alternate.lang !== lang).map((alternate) => <meta property="og:locale:alternate" content={openGraphLocale(alternate.lang)} />)}
{type === 'article' && <meta property="article:author" content={SITE_AUTHOR} />}
{pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image.src, Astro.site)} />
