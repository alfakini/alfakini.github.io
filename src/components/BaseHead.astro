---
import type { ImageMetadata } from 'astro';
import { SITE_AUTHOR, SITE_TITLE } from '../consts';
import { defaultLocale, localeCode, openGraphLocale, type Locale } from '../lib/locale';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	type?: 'website' | 'article';
	lang?: Locale;
	published_at?: Date;
	updated_at?: Date;
	tags?: string[];
	alternates?: Array<{ lang: Locale; href: string }>;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const {
	title,
	description,
	image,
	type = 'website',
	lang = defaultLocale,
	published_at,
	updated_at,
	tags = [],
	alternates = [],
} = Astro.props;
const defaultAlternate = alternates.find((alternate) => alternate.lang === defaultLocale);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('/rss.xml', Astro.site)} />
<link rel="canonical" href={canonicalURL} />
{alternates.map((alternate) => <link rel="alternate" hreflang={localeCode(alternate.lang)} href={new URL(alternate.href, Astro.site)} />)}
{defaultAlternate && <link rel="alternate" hreflang="x-default" href={new URL(defaultAlternate.href, Astro.site)} />}
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE_AUTHOR} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{image && <meta property="og:image" content={new URL(image.src, Astro.site)} />}
{image && <meta property="og:image:width" content={image.width.toString()} />}
{image && <meta property="og:image:height" content={image.height.toString()} />}
<meta property="og:locale" content={openGraphLocale(lang)} />
{alternates.filter((alternate) => alternate.lang !== lang).map((alternate) => <meta property="og:locale:alternate" content={openGraphLocale(alternate.lang)} />)}
{type === 'article' && <meta property="article:author" content={SITE_AUTHOR} />}
{published_at && <meta property="article:published_time" content={published_at.toISOString()} />}
{updated_at && <meta property="article:modified_time" content={updated_at.toISOString()} />}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{image && <meta name="twitter:image" content={new URL(image.src, Astro.site)} />}
