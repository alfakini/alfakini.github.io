---
import type { Essay } from '../lib/essays';
import { currentLocale } from '../i18n';
import { routeUrl } from '../i18n/routes';
import EssayMeta from './EssayMeta.astro';

interface Props {
	essays: Essay[];
}
const { essays } = Astro.props;
const lang = currentLocale(Astro.currentLocale);
---

<ol class="essay-list">
	{essays.map((essay) => {
		return (
			<li>
				<EssayMeta {essay} />
				<h2><a href={routeUrl(lang, 'essays', essay.data.slug)}>{essay.data.title}</a></h2>
				<p>{essay.data.description}</p>
			</li>
		);
	})}
</ol>
