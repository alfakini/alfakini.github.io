---
import type { Essay } from '../lib/essays';
import { essayIdentity, essayPath } from '../lib/essays';
import FormattedDate from './FormattedDate.astro';

interface Props {
	essay: Essay;
	translations: Essay[];
	updatedLabel?: string;
}
const { essay, translations, updatedLabel } = Astro.props;
const { lang } = essayIdentity(essay);
const languagesLabel = lang === 'pt' ? 'Idiomas disponíveis' : 'Available languages';
---

<div class="essay-meta sans">
	<FormattedDate date={essay.data.published_at} lang={lang} />
	{essay.data.updated_at && updatedLabel && <><span aria-hidden="true">·</span> {updatedLabel} <FormattedDate date={essay.data.updated_at} lang={lang} /></>}
	<span class="essay-list-separator" aria-hidden="true">·</span>
	<span class="essay-list-languages" aria-label={languagesLabel}>
		{translations.map((translation) => {
			const { lang: translationLang } = essayIdentity(translation);
			const label = translationLang === 'pt' ? 'Ler em português' : 'Read in English';
			return <a class="essay-list-language" href={essayPath(translation)} hreflang={translationLang} lang={translationLang} aria-label={label} aria-current={translationLang === lang ? 'page' : undefined}>{translationLang}</a>;
		})}
	</span>
</div>
