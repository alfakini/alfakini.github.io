---
import type { Essay } from '../lib/essays';
import { essayIdentity, essayPath } from '../lib/essays';
import FormattedDate from './FormattedDate.astro';

interface Props { essay: Essay; translations: Essay[]; updatedLabel?: string }
const { essay, translations, updatedLabel } = Astro.props;
const { lang } = essayIdentity(essay);
---

<div class="essay-meta sans">
	<FormattedDate date={essay.data.pubDate} lang={lang} />
	{essay.data.updatedDate && updatedLabel && <> · {updatedLabel} <FormattedDate date={essay.data.updatedDate} lang={lang} /></>}
	<span class="post-list-separator" aria-hidden="true">·</span>
	<span class="post-list-languages" aria-label="Available languages">
		{translations.map((translation) => {
			const { lang: translationLang } = essayIdentity(translation);
			const label = translationLang === 'pt' ? 'Ler em português' : 'Read in English';
			return <a class="post-list-language" href={essayPath(translation)} hreflang={translationLang} lang={translationLang} aria-label={label} aria-current={translationLang === lang ? 'page' : undefined}>{translationLang}</a>;
		})}
	</span>
</div>
