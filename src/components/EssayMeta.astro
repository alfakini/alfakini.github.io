---
import type { Essay } from '../lib/essays';
import { currentLocale } from '../i18n';
import FormattedDate from './FormattedDate.astro';

interface Props {
	essay: Essay;
	updatedLabel?: string;
}
const { essay, updatedLabel } = Astro.props;
const lang = currentLocale(Astro.currentLocale);
---

<div class="essay-meta sans">
	<FormattedDate date={essay.data.published_at} lang={lang} />
	{essay.data.updated_at && updatedLabel && <><span aria-hidden="true">·</span> {updatedLabel} <FormattedDate date={essay.data.updated_at} lang={lang} /></>}
</div>
