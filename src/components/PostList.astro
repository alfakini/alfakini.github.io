---
import type { Essay, Locale } from '../lib/essays';
import { essayIdentity, essayPath } from '../lib/essays';
import FormattedDate from './FormattedDate.astro';

interface Props { essays: Essay[]; languages: Map<string, Locale[]> }
const { essays, languages } = Astro.props;
---

<ol class="post-list">
	{essays.map((essay) => {
		const { lang, slug } = essayIdentity(essay);
		const available = languages.get(slug) ?? [lang];
		return (
			<li>
				<div class="post-list-date sans">
					<FormattedDate date={essay.data.pubDate} lang={lang} />
					<span class="post-list-languages">{available.join(' / ')}</span>
				</div>
				<h2><a href={essayPath(essay)}>{essay.data.title}</a></h2>
				<p>{essay.data.description}</p>
			</li>
		);
	})}
</ol>
