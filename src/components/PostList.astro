---
import type { Essay } from '../lib/essays';
import { essayIdentity, essayPath } from '../lib/essays';
import EssayMeta from './EssayMeta.astro';

interface Props { essays: Essay[]; languages: Map<string, Essay[]> }
const { essays, languages } = Astro.props;
---

<ol class="post-list">
	{essays.map((essay) => {
		const { slug } = essayIdentity(essay);
		const available = languages.get(slug) ?? [essay];
		return (
			<li>
				<EssayMeta {essay} translations={available} />
				<h2><a href={essayPath(essay)}>{essay.data.title}</a></h2>
				<p>{essay.data.description}</p>
			</li>
		);
	})}
</ol>
