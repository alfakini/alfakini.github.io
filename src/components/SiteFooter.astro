---
import { SITE_AUTHOR } from '../consts';
import { currentLocale, useT } from '../i18n';
import { routeUrl } from '../i18n/routes';

const lang = currentLocale(Astro.currentLocale);
const t = useT(lang);
---

<footer class="site-footer sans">
	<p>&copy; {new Date().getFullYear()} {SITE_AUTHOR}.</p>
	<nav aria-label={t('footer.navigation')}>
		<a href={routeUrl(lang, 'tags')}>{t('footer.tags')}</a>
		<a href="/rss.xml">RSS</a>
	</nav>
</footer>
