---
import { defaultLocale, localeCode, type Locale } from '../i18n';

interface Props {
	date: Date;
	lang?: Locale;
}
const { date, lang = defaultLocale } = Astro.props;
---

<time datetime={date.toISOString()}>{date.toLocaleDateString(localeCode(lang), { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</time>
