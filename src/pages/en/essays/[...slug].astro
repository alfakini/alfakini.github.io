---
import { render } from 'astro:content';
import EssayMeta from '../../../components/EssayMeta.astro';
import { currentLocale, useT } from '../../../i18n';
import { getEssayStaticPaths, type Essay } from '../../../lib/essays';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';

export const getStaticPaths = () => getEssayStaticPaths('en');

interface Props {
	essay: Essay;
}
const { essay } = Astro.props;
const { Content } = await render(essay);
const lang = currentLocale(Astro.currentLocale);
const t = useT(lang);
---

<ArticleLayout article={essay.data} linkTags>
	<EssayMeta slot="meta" {essay} updatedLabel={t('article.updated')} />
	<Content />
</ArticleLayout>
