---
import { render } from 'astro:content';
import { getEssayStaticPaths, type Essay } from '../../lib/essays';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export const getStaticPaths = () => getEssayStaticPaths('pt-BR');

interface Props {
	essay: Essay;
}
const { essay } = Astro.props;
const { Content } = await render(essay);
---

<ArticleLayout {essay}>
	<Content />
</ArticleLayout>
