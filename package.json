{
  "name": "alfakini.github.io",
  "private": true,
  "scripts": {
    "build": "tailwindcss -i ./src/input.css -o ./src/output.css --minify",
    "watch": "tailwindcss -i ./src/input.css -o ./src/output.css --minify --watch",
    "build:vcard": "tailwindcss -i ./vcard/style/input.css -o ./vcard/style/output.css --minify",
    "watch:vcard": "tailwindcss -i ./vcard/style/input.css -o ./vcard/style/output.css --minify --watch"
  },
  "devDependencies": {
    "tailwindcss": "^4.1.13",
    "@tailwindcss/cli": "^4.1.13"
  }
}
